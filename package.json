{
	"name": "mcp-idle-game",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "MCP idle game: LLM-agent plays an incremental game over the Model Context Protocol",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"start": "node dist/bootstrap/server.js",
		"dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
		"dev:api": "node --watch src/bootstrap/server.ts",
		"dev:web": "vite",
		"build": "pnpm run build:server && pnpm run build:web",
		"build:server": "tsc -p tsconfig.json",
		"build:web": "vite build",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"autotune": "node src/bootstrap/autotune.ts",
		"sim": "node src/bootstrap/sim.ts",
		"keys": "node src/bootstrap/keys.ts",
		"format": "prettier --write . --log-level=warn"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.3.1",
		"mcp-handler": "^2.3.0",
		"neverthrow": "^8.2.0",
		"prettier": "^3.9.10",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
