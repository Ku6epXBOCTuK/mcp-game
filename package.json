{
  "name": "mcp-idle-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP idle game: LLM-agent plays an incremental game over the Model Context Protocol",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/bootstrap/server.js",
    "dev": "node --watch src/bootstrap/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "autotune": "node src/bootstrap/autotune.ts",
    "keys": "node src/bootstrap/keys.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "mcp-handler": "^2.3.0",
    "neverthrow": "^8.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
